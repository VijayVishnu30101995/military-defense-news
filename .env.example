DATABASE_URL=postgresql+psycopg://defense_news:defense_news@localhost:5434/defense_news
ADMIN_EMAIL=admin@defensebrief.com
ADMIN_PASSWORD=change-me

# Optional: watchlist emails link back to the app at this address.
FRONTEND_URL=http://127.0.0.1:5500

# Optional: email for watchlist alerts and source-failure alerts. Without SMTP_HOST,
# watchlist alerts show in the app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=
